# Copy to .env (never commit .env). Run the server from the backend/ directory.

APP_ENV=development                 # set to "production" to disable /docs and /openapi.json
LOG_LEVEL=INFO

# Comma-separated, explicit origins of the React frontend ("*" is rejected)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local development: path to the service-account JSON you download from Firebase.
# Leave empty on Cloud Run / GCE to use Application Default Credentials.
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# Optional, only needed if it can't be inferred from the credentials
FIREBASE_PROJECT_ID=

# true = also check Firebase revocation on every request (one extra network call per request)
CHECK_TOKEN_REVOKED=false

# --- Phase 2: invitations ---
# Invitations are matched by email, so the user's email must be verified in Firebase Auth.
# KEEP true in production. For local testing only, you may set false if you have not built
# an email-verification step yet (Firebase email/password sign-ups are unverified by default).
REQUIRE_VERIFIED_EMAIL=true

# Days until a pending invitation expires
INVITATION_TTL_DAYS=7

# --- Phase 3: knowledge base files, stored in Cloudflare R2 (S3-compatible) ---
# NEVER commit real values. These stay on the server; the frontend never sees them.
# Cloudflare dashboard -> R2 -> Overview shows your Account ID and S3 API endpoint.
R2_ACCOUNT_ID=
# From R2 -> Manage API Tokens -> Create API token (permission: Object Read & Write, scoped to the bucket).
# The secret is shown only once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: if empty it is built from R2_ACCOUNT_ID. Must start with https://
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto

# Maximum upload size in MB (1-50). Files are processed in memory, so keep this modest.
MAX_UPLOAD_MB=10

# --- Phase 4: retrieval-augmented generation ---
# Backend only. Keep keys out of React and never commit real values.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=business_knowledge
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
# Cosine score cutoff used to omit weak matches before answer generation.
RAG_MIN_SCORE=0.2
