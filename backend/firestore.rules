rules_version = '2';

// All data access goes through the FastAPI backend using the Admin SDK, which bypasses
// these rules. Client SDKs (the React app) therefore get NO direct access to Firestore.
// Tenant authorization is enforced in the backend (membership check on every request).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
