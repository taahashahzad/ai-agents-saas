# Backend API base URL (no trailing slash, no /api/v1 suffix - paths are defined in src/services/endpoints.js)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Maximum upload size in MB for Knowledge Base documents (optional, default 10).
# The backend does not expose its limit, so keep this equal to the backend's MAX_UPLOAD_MB.
VITE_MAX_UPLOAD_MB=10

# Firebase web app config (Firebase Console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
